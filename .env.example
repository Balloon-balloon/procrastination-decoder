# ============================================
# AI API 配置（可选，不配置时使用内置模板）
# ============================================

# 方式一：使用 DeepSeek（推荐，便宜好用）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 方式二：使用 OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 方式三：自定义 API（兼容 OpenAI 格式的任意服务）
# AI_API_KEY=your_key_here
# AI_API_BASE_URL=https://api.example.com/v1
# AI_MODEL=model-name

# 说明：
# - 优先级：自定义(AI_API_KEY) > DeepSeek > OpenAI
# - 不配置任何 Key 时，AI拆解和AI教练会使用内置的启发式模板（效果有限）
# - 配置后重启 dev server 生效
