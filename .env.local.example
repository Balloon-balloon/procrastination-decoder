# ========== 邮箱验证配置 ==========
# 方式 1: 使用 Resend（推荐，免费 100 封/天）
# 1. 去 https://resend.com 注册账号
# 2. 获取 API Key（以 re_ 开头）
# 3. 验证你的发件域名（或用 onboarding@resend.dev 测试）
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# 方式 2: 使用 Nodemailer + SMTP（如 QQ邮箱、Gmail等）
# QQ邮箱: smtp.qq.com 端口 465，密码用授权码不是登录密码
# Gmail: smtp.gmail.com 端口 587，密码用 App Password
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code
SMTP_FROM=your_email@qq.com

# ========== 应用配置 ==========
# 网站域名（用于验证链接）
NEXT_PUBLIC_APP_URL=http://localhost:3003
