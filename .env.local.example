# ========== 邮箱验证配置（两种方式选择一种）==========

# 方式 1：Resend（推荐）
# 1. 在 https://resend.com 创建 API Key
# 2. 正式给任意注册用户发信前，必须在 Resend 验证自己的域名
# 3. onboarding@resend.dev 仅适合给 Resend 账号本人的邮箱做测试
# RESEND_API_KEY=re_replace_with_your_real_key
# RESEND_FROM_EMAIL=whywait <verify@your-verified-domain.com>

# 方式 2：Nodemailer + SMTP（如 QQ 邮箱、Gmail）
# QQ 邮箱：smtp.qq.com，465，密码必须填 SMTP 授权码而不是登录密码
# Gmail：smtp.gmail.com，465 或 587，密码使用 App Password
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-real-email@qq.com
# SMTP_PASS=replace_with_your_smtp_authorization_code
# SMTP_FROM=whywait <your-real-email@qq.com>

# ========== 应用配置 ==========
# 验证邮件中链接所使用的公网地址；本地开发可改为实际 dev 端口
APP_URL=http://localhost:3000

# 数据文件路径（部署时应指向持久化磁盘）
# WHYWAIT_DATA_FILE=/data/whywait/whywait-db.json
